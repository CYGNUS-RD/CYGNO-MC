# One job per ion; set G4FORCENUMBEROFTHREADS=1 before launching CYGNO.
# 1,000,000 events; 0.25 keV-1 MeV total ion energy, random log-uniform.
# Fixed center of the +z sensitive gas volume; isotropic initial direction (4pi).
# Gas pressure/temperature are compiled properties.
/control/verbose 0
/run/verbose 1
/event/verbose 0
/tracking/verbose 0
/gps/verbose 0
/gps/particle ion
/gps/ion 9 19
/gps/number 1
/gps/pos/type Point
/gps/pos/centre 0 0 245 mm
/gps/ang/type iso
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 180 deg
/gps/ang/minphi 0 deg
/gps/ang/maxphi 360 deg
/gps/ene/type Pow
/gps/ene/min 0.25 keV
/gps/ene/max 1 MeV
/gps/ene/alpha -1
/CYGNO/primaryGenerator/fillNtuple true
/CYGNO/outfile nr_4pi_F19
/random/setSeeds 245636896 230908982
/run/beamOn 1000000
